<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CubeOS: iOS 26 keyboard (light): white keys, including shift, 123 and return, on a
         light grey sheet, no hint characters. -->
    <color name="keyboard_panel_rim_you">#FFF4F5F7</color>
    <color name="keyboard_background_you">#FFD3D5DB</color>
    <!-- Keys -->
    <color name="keyboard_key_normal_color_you">#FFFFFFFF</color>
    <color name="keyboard_key_pressed_color_you">#FFC2C5CC</color>
    <color name="keyboard_key_text_color_you">#FF000000</color>
    <color name="keyboard_key_functional_normal_color_you">#FFFFFFFF</color>
    <color name="keyboard_key_functional_pressed_color_you">#FFC2C5CC</color>
    <color name="keyboard_key_functional_text_color_you">#FF000000</color>
    <color name="keyboard_key_action_normal_color_you">#FFFFFFFF</color>
    <color name="keyboard_key_action_pressed_color_you">#FFC2C5CC</color>
    <color name="shift_normal_color_you">#FF000000</color>
    <color name="shift_locked_color_you">#FF000000</color>
    <color name="icon_color_you">#FF000000</color>
    <color name="key_hint_letter_color_you">@android:color/transparent</color>
    <!-- Suggestion bar -->
    <color name="typed_word_color_you">#FF000000</color>
    <color name="auto_correct_color_you">#FF000000</color>
    <color name="suggested_word_color_you">#FF000000</color>
    <!-- Gesture input -->
    <color name="gesture_trail_color_you">@android:color/system_accent1_500</color>
    <color name="gesture_floating_preview_text_color_you">@android:color/system_neutral1_1000</color>
    <!-- Misc -->
    <color name="highlight_color_you">@android:color/system_accent1_500</color>
    <color name="emoji_tab_page_indicator_background_you">#FFD3D5DB</color>
</resources>
